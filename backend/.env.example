DATABASE_URL=postgresql+psycopg2://iot:iot_secret@localhost:5432/iot_ops
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TELEMETRY_TOPIC=iot/devices/+/telemetry
MQTT_STATUS_TOPIC=iot/devices/+/status
MQTT_EVENTS_TOPIC=iot/events/#
TEMP_ALERT_THRESHOLD=40.0
CORS_ORIGINS=http://localhost:4200,http://localhost:8000,http://localhost
ML_ENABLED=true
ML_MIN_SAMPLES=25
ML_CONTAMINATION=0.02
ML_TRAIN_WINDOW=200
JWT_SECRET=change-me-iot-ops-dev-secret
JWT_EXPIRE_MINUTES=480
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=operator123
SEED_VIEWER_EMAIL=viewer@example.com
